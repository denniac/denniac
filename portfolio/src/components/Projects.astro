---
import ProjectPreview from "./ProjectPreview.astro";

const projects = [
  {
    title: "Chessgo",
    description:
      "Modern online chess platform built with Go and Astro, focused on realtime gameplay, scalable backend architecture and low-latency communication.",
    tags: ["Go", "WebSockets", "Clean Architecture"],
    repoUrl: "https://github.com/denniac/chessgo",
  },
];
---

<section id="projects" class="mx-auto max-w-7xl px-6 pb-24">
  <div class="mb-12">
    <h2 class="font-[Space_Grotesk] text-3xl font-bold text-white md:text-4xl">
      Featured Project
    </h2>

    <p class="mt-4 max-w-2xl text-gray-400">
      Projects focused on scalability, realtime systems and clean architecture.
    </p>
  </div>

  {
    projects.map(({ title, description, tags, repoUrl }) => (
      <article class="rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur">
        <div class="flex flex-wrap items-center gap-3">
          {tags.map((tag) => (
            <span class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-sm text-gray-300">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex gap-4 sm:flex-col">
          <div>
            <h3 class="mt-6 font-[Space_Grotesk] text-3xl font-bold text-white">
              {title}
            </h3>

            <p class="mt-4 max-w-3xl leading-relaxed text-gray-400">
              {description}
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href={repoUrl}
                target="_blank"
                class="rounded-2xl bg-[#29BE43] px-5 py-3 font-medium text-black transition hover:scale-[1.02]"
              >
                View Repository
              </a>
            </div>
          </div>
          <div class="ml-auto w-full md:w-100">
            <ProjectPreview externalUrl="https://chessgo.net" title={title} />
          </div>
        </div>
      </article>
    ))
  }
</section>
