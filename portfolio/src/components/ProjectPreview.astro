---
const { externalUrl, title, height = '250px' } = Astro.props;
---

<div class="relative w-full overflow-hidden rounded-2xl">
  <iframe
    src={externalUrl}
    title={title}
    width="100%"
    height={height}
    style="border: none; pointer-events: none; display: block; overflow: hidden;"
  />
</div>
