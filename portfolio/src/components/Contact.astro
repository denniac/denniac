---
const email = "danachuryc@gmail.com";
---

<section id="contact" class="contact section-pad">
  <div class="contact-card">
    <p class="eyebrow">HAVE A PROJECT IN MIND?</p>
    <h2>
      Let's build<br />
      <em>something that lasts.</em>
    </h2>
    <p class="contact-copy">
      Whether you're solving a hard technical problem or starting from zero,
      I'd love to hear about it.
    </p>

    <div class="contact-actions">
      <a class="button button-light" href={`mailto:${email}`}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        Send me a note
      </a>

      <button
        id="copyButton"
        class="copy-button"
        type="button"
        data-email={email}
      >
        <svg
          class="icon-copy"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
        </svg>
        <svg
          class="icon-check"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display: none"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span class="copy-label">{email}</span>
      </button>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("#copyButton");
  const email = button?.dataset.email ?? "";

  function renderCopied() {
    const copyIcon = button?.querySelector<SVGElement>(".icon-copy");
    const checkIcon = button?.querySelector<SVGElement>(".icon-check");
    const label = button?.querySelector<HTMLSpanElement>(".copy-label");

    copyIcon?.style.setProperty("display", "none");
    checkIcon?.style.setProperty("display", "block");
    if (label) label.textContent = "Copied";
  }

  function renderEmail() {
    const copyIcon = button?.querySelector<SVGElement>(".icon-copy");
    const checkIcon = button?.querySelector<SVGElement>(".icon-check");
    const label = button?.querySelector<HTMLSpanElement>(".copy-label");

    copyIcon?.style.setProperty("display", "block");
    checkIcon?.style.setProperty("display", "none");
    if (label) label.textContent = email;
  }

  button?.addEventListener("click", async () => {
    if (navigator.clipboard) {
      await navigator.clipboard.writeText(email);
    }
    renderCopied();
    window.setTimeout(renderEmail, 1800);
  });
</script>